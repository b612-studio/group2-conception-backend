DATABASE_URL=postgres://events:events@localhost:55432/events
POSTGRES_PORT=55432
# Use valkey or valkey-functional instead of postgres to select a Valkey adapter.
EVENT_REPOSITORY=postgres
VALKEY_URL=redis://localhost:56379
VALKEY_PORT=56379
ADMINER_PORT=8080
PORT=3000
# Optional. /mcp and tests work without a model API key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
